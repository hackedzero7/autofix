NEXT_PUBLIC_SITE_URL=https://www.proautocare.co
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=paste-your-google-search-console-code-here

# Server-only values. Copy to .env.local; never commit actual credentials.
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/YOUR_DATABASE
CRM_ADMIN_EMAIL=admin@example.com
CRM_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
CRM_ADMIN_NAME=Administrator

# Canonical public MCP URL; use the same hostname as your CRM login.
# Local development: http://localhost:3000/mcp
MCP_SERVER_URL=https://www.proautocare.co/mcp
